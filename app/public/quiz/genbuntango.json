  "chapters": [
    {
      "chapter": 1,
      "vocabulary": [
        {
          "id": "ebca7160-39b8-462d-855d-6d1562c4a876",
          "expression": "具体",
          "definitions": [
            "人間の感覚でとらえられる形や内容を備えていること。"
          ]
        },
        {
          "id": "10877996-e16a-4fc2-bbf3-88186cc42848",
          "expression": "抽象",
          "definitions": [
            "事物の性質、共通性に着目し、それを引き出してとらえること。"
          ]
        },
        {
          "id": "7a7c41de-0e05-4421-954f-e67ecf83030b",
          "expression": "絶対",
          "definitions": [
            "他に比較できるもののないこと。他から影響や制限を受けないこと。"
          ]
        },
        {
          "id": "eb972a02-888c-459a-b228-909b37e9eb2f",
          "expression": "相対",
          "definitions": [
            "他との関係において存在すること。向かい合うこと。"
          ]
        },
        {
          "id": "7b7ea867-c0ca-4543-9459-60589893d6f4",
          "expression": "主観",
          "definitions": [
            "外界との出来事に対する自分の意識。自分だけの個人的な考え。"
          ]
        },
        {
          "id": "3f59ca13-9409-47fa-bf8d-47add677987a",
          "expression": "客観",
          "definitions": [
            "認識や行動の対象となるもの。主観から独立して存在するもの。"
          ]
        },
        {
          "id": "f5de778d-2c6e-40b2-a74f-dbda6dbcaaa9",
          "expression": "現象",
          "definitions": [
            "感覚によってとらえられるすべてのもの。表面だけに現れたもの。"
          ]
        },
        {
          "id": "5cd47ae1-cd3d-4e20-b611-9e7b1726631d",
          "expression": "本質",
          "definitions": [
            "物事の根本的な性質や要素。存在するものの基底をなすもの。"
          ]
        },
        {
          "id": "f93fed31-46bb-4679-87c8-7188d8f0e739",
          "expression": "画一",
          "definitions": [
            "形や性質などの違いがないこと。すべて同じようにそろえること。"
          ]
        },
        {
          "id": "066b8971-1f31-4894-a99c-d0116302cb86",
          "expression": "多様",
          "definitions": [
            "さまざまに異なること。種類が多いさま。"
          ]
        },
        {
          "id": "a84118e5-fdae-4725-af4f-75e72778a58e",
          "expression": "帰納",
          "definitions": [
            "個別の具体的な事実から一般的な法則を導き出すこと。"
          ]
        },
        {
          "id": "b3118532-c3c5-4c98-8aeb-473de2558400",
          "expression": "演繹",
          "definitions": [
            "一般的な前提から個別の結論を引き出すこと。"
          ]
        },
        {
          "id": "12a8aeae-20cc-4143-b06b-3565ff189c8b",
          "expression": "総合",
          "definitions": [
            "一つ一つのものをまとめ合わせて、全体をとらえること。"
          ]
        },
        {
          "id": "7d60959b-e8cd-4132-9e52-1abb4e5877b0",
          "expression": "分析",
          "definitions": [
            "物事を細かな要素に分解して、部分を明らかにすること。"
          ]
        },
        {
          "id": "019e06e3-5be6-4fcb-b1d6-f1f3c26e3ce6",
          "expression": "自然",
          "definitions": [
            "人の手があまり加わっていない、ありのままの状態。"
          ]
        },
        {
          "id": "6a6ed3f5-9740-4843-92c2-ae4ee737a61b",
          "expression": "人為",
          "definitions": [
            "人の手を加えること。人のしわざ。"
          ]
        },
        {
          "id": "5460192c-18d2-4dff-9124-2b89deb5fa8a",
          "expression": "身体",
          "definitions": [
            "人の体。肉体。"
          ]
        },
        {
          "id": "c043ba31-c826-4187-8335-8e883e6b1e99",
          "expression": "精神",
          "definitions": [
            "心。物事に対する心のもち方や働き。根本の意義。"
          ]
        },
        {
          "id": "4ff9da49-4709-4420-a5dd-dec8a8c69a76",
          "expression": "顕在",
          "definitions": [
            "はっきり形に現れて、存在すること。"
          ]
        },
        {
          "id": "32b6ebe3-c6f7-4621-959a-6b43876476fa",
          "expression": "潜在",
          "definitions": [
            "内部に隠れていて、表面に現れずに存在すること。"
          ]
        },
        {
          "id": "88aef00b-4d45-4707-81fd-863ce33d3afe",
          "expression": "内包",
          "definitions": [
            "ある概念がもつ共通の性質。内部を包みもつこと。"
          ]
        },
        {
          "id": "293d66db-f84c-4972-bab5-ac32db21386c",
          "expression": "外延",
          "definitions": [
            "ある概念が適用される最大の範囲。"
          ]
        },
        {
          "id": "4c619a9b-9ad3-4193-ad6f-4a14d3c70b8e",
          "expression": "創造",
          "definitions": [
            "それまでなかったものを新しく作り出すこと。"
          ]
        },
        {
          "id": "5daf5f30-0beb-4d73-a403-468f3dd90ec3",
          "expression": "模倣",
          "definitions": [
            "まねること。似せること。"
          ]
        },
        {
          "id": "031831df-6bb0-4c6e-a331-72fb6b6bad5d",
          "expression": "ロゴス",
          "definitions": [
            "理性。理知。言語。論理。"
          ]
        },
        {
          "id": "e5d6923f-d4e6-417b-a517-ac3765a08989",
          "expression": "パドス",
          "definitions": [
            "感情。情熱。情念。"
          ]
        },
        {
          "id": "be7dbe58-c378-4ea5-bb38-1e3587506d76",
          "expression": "普遍",
          "definitions": [
            "例外なく全てに共通すること。広く行き渡ること。"
          ]
        },
        {
          "id": "f1bc0c78-fd41-46f3-a2e8-db462498f775",
          "expression": "特殊",
          "definitions": [
            "他の普通のものとは異なること。"
          ]
        },
        {
          "id": "3ef421b7-2566-4e1e-8842-251ce19cdd80",
          "expression": "形而上",
          "definitions": [
            "形を超越した、精神的なもの。"
          ]
        },
        {
          "id": "0e92882a-b6dd-43f8-9ed2-dc435e90828a",
          "expression": "形而下",
          "definitions": [
            "時間や空間の中で形をとって現れるもの。"
          ]
        },
        {
          "id": "2666b3af-ed02-4912-abee-c2fd0856a077",
          "expression": "秩序",
          "definitions": [
            "物事や社会を正しく保つための順番や決まり。"
          ]
        },
        {
          "id": "b98af023-9bf2-4e19-9b0b-358566842f3a",
          "expression": "混沌",
          "definitions": [
            "物事が入り混じって、はっきりと区別がつかないさま。"
          ]
        },
        {
          "id": "96b6a06f-37ae-437e-b2f2-4c4c23922519",
          "expression": "一元",
          "definitions": [
            "全ての物事の根源が一つであること。"
          ]
        },
        {
          "id": "492a09c2-a286-4c7a-b6e4-06bab0bc695f",
          "expression": "多元",
          "definitions": [
            "互いに独立した、多くの原理や要素があること。"
          ]
        },
        {
          "id": "b9937b7a-fb3c-4f87-b308-4e7033e12e5f",
          "expression": "現実",
          "definitions": [
            "実際に今、目の前に現れている事実や状態。"
          ]
        },
        {
          "id": "3402b086-40d4-44da-8eb2-0f9bf3106c20",
          "expression": "理想",
          "definitions": [
            "最善の姿や状態として求めるもの。"
          ]
        },
        {
          "id": "5ae238e4-00b2-4fd9-8b02-23e4f556e3f4",
          "expression": "建前",
          "definitions": [
            "表向きの方針や考え方。"
          ]
        },
        {
          "id": "42c7aa86-d0de-4716-be3e-680ae31f9c5a",
          "expression": "本音",
          "definitions": [
            "本当の気持ち。本当の気持ちから出る言葉。"
          ]
        },
        {
          "id": "c9ff9f1a-95c1-4c7d-abeb-0cad9a179bf8",
          "expression": "肯定",
          "definitions": [
            "物事をその通りであると認めること。存在や意義を認めること。"
          ]
        },
        {
          "id": "9f540355-aa28-43bb-a0cf-06d9ef494227",
          "expression": "否定",
          "definitions": [
            "物事をそうではないと退けて、打ち消すこと。"
          ]
        }
      ]
    }
  ]
}